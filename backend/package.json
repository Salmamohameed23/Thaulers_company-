{
  "name": "tough-haulers-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:electric-scooters": "node src/utils/seedElectricScooterCategories.js",
    "seed:kitchenware": "node src/utils/seedKitchenwareCategories.js",
    "seed:production-lines": "node src/utils/seedProductionLineCategories.js",
    "seed:hotel-supplies": "node src/utils/seedHotelSupplyCategories.js",
    "seed:tools-hardware": "node src/utils/seedToolsHardwareCategories.js",
    "seed:categories": "npm run seed:electric-scooters && npm run seed:kitchenware && npm run seed:production-lines && npm run seed:hotel-supplies && npm run seed:tools-hardware"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.2.0",
    "mongoose": "^9.10.0",
    "morgan": "^1.12.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.9",
    "qs": "^6.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
